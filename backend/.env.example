# Production server
NODE_ENV=production
PORT=10000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weddingbingo

# Authentication
JWT_SECRET=generate-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Wedding Bingo Owner

# Frontend/CORS: use the deployed frontend URL(s), comma-separated if needed
FRONTEND_URL=https://weddingbingoun.netlify.app
CORS_ORIGINS=https://weddingbingoun.netlify.app

# SMTP
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
