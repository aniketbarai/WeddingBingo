# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/weddingbingo

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Wedding Bingo Owner

# Frontend/CORS
FRONTEND_URL=http://localhost:5173

# SMTP - required for password reset and email workflows
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Optional production media/analytics configuration
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
CDN_BASE_URL=
ANALYTICS_PROVIDER=
ANALYTICS_ID=
