# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/weddingbingo

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Wedding Bingo Owner

# Frontend/CORS
FRONTEND_URL=http://localhost:5173

# SMTP - required for password reset, contact form, and booking emails
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# ImageKit - required for gallery/media uploads (all three are mandatory in production)
# Get these from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional analytics configuration
ANALYTICS_PROVIDER=
ANALYTICS_ID=
